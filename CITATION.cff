date-released: "2026-11-02"
repository-code: "https://github.com/Ethersense/ethersense-artifact"
url: "https://github.com/Ethersense/ethersense-artifact"
keywords:
  - Wi-Fi sensing
  - electrical load monitoring
  - spectral analysis
  - software artifact
