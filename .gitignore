__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.env
.env.*
.vscode/
.idea/
*.log
*.tmp

# --- large recordings and derived binaries ---------------------------------
# Keep the layout and the documentation in Git; keep the 35 GB of IQ out of it.
# (A single .wav is 70-330 MB, above GitHub's 100 MB file limit; use Git LFS or
#  DVC if you really need the recordings versioned.)
data/raw/**/*.cs8
data/raw/**/*.wav
data/raw/**/*.zip
data/processed/**/*.npz
!data/raw/README.md

# Explicitly released original archives (stored with Git LFS).

# Local execution outputs and private access material.
*.pem
*.key
id_ed25519*
id_rsa*
.ssh/
revision_workspace/attachments/

# Reconstructed auxiliary archives are generated from tracked small parts.
data/auxiliary/*.zip
data/auxiliary/**/*.zip
*.assembling
